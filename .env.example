# ==========================================
# AI Agent Workflow Automation Environment
# ==========================================

# Optional: Add live LLM API keys for GPT-4o / Claude / Gemini
# The system operates out-of-the-box with deterministic offline AI fallback
# if no API keys are provided.

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (Optional)
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic (Optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Telemetry / Debug
DEBUG_MODE=True
LOG_LEVEL=INFO
